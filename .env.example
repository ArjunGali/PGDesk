# Copy to .env and adjust. Used by docker-compose.
POSTGRES_USER=pgm
# No default. Docker Compose refuses to start until this is set.
POSTGRES_PASSWORD=
POSTGRES_DB=pg_management
POSTGRES_PORT=5432
BACKEND_PORT=3000

# Secrets. All three are required; there are no fallbacks in code or compose.
#   openssl rand -hex 32     -> JWT_SECRET
#   openssl rand -base64 32  -> AADHAAR_ENCRYPTION_KEY
#
# AADHAAR_ENCRYPTION_KEY encrypts Aadhaar numbers at rest. Losing it makes
# every stored Aadhaar unrecoverable — back it up separately from the database.
JWT_SECRET=
AADHAAR_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost
