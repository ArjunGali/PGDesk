# Copy to .env and adjust. Used by docker-compose.
POSTGRES_USER=pgm
POSTGRES_PASSWORD=pgm_password
POSTGRES_DB=pg_management
POSTGRES_PORT=5432
BACKEND_PORT=3000

# Generate real secrets before exposing the backend beyond your LAN:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost
