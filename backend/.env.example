DATABASE_URL="postgresql://pgm:CHANGE_ME@localhost:5432/pg_management?schema=public"
PORT=3000

# Required. The server refuses to start without it.
#   openssl rand -hex 32
JWT_SECRET=""

# Required before any Aadhaar number can be stored or read.
# AES-256-GCM key, 32 bytes as base64 or 64 hex characters.
#   openssl rand -base64 32
#
# Back this up separately from the database. Without it, stored Aadhaar
# numbers cannot be decrypted; everything else in the app keeps working.
AADHAAR_ENCRYPTION_KEY=""

JWT_EXPIRES_IN="12h"
JWT_REFRESH_EXPIRES_IN="30d"
STORAGE_ROOT="./storage"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost"
SEED_OWNER_USERNAME="owner"
# App PIN for the Owner profile. 4-8 digits, no repeats or runs like 1234.
# Left blank on purpose: a value written here would be the Owner PIN of every
# installation that never changed it. Leave it blank and the seed generates one
# and prints it once, or set your own before seeding.
SEED_OWNER_PIN="
