<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. Android 8+ composes the two layers itself and masks
  the result to whatever shape the launcher uses, so the glyph stays inside the
  safe area no matter whether the device draws circles, squircles or squares.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
